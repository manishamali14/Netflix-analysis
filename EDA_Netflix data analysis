":"stream"}],"execution_count":109},{"cell_type":"markdown","source":"**Data Cleaning**","metadata":{}},{"cell_type":"code","source":"print(\"Original shape:\", df.shape)\nprint(df.isna().sum())\n\n# Remove exact duplicates\nprint(\"Duplicate rows:\", df.duplicated().sum())\ndf = df.drop_duplicates()\n\n# Strip extra spaces from text columns\ntext_cols = [\"type\", \"title\", \"director\", \"cast\", \"country\", \"rating\", \"listed_in\"]\ndf[text_cols] = df[text_cols].apply(lambda col: col.str.strip())\n\n# A few movie durations ended up in the rating column - move them back\nwrong = df[\"rating\"].str.contains(\"min\", na=False)\ndf.loc[wrong, \"duration\"] = df.loc[wrong, \"rating\"]\ndf.loc[wrong, \"rating\"] = np.nan\n\n# Fill missing text values\ndf[[\"director\", \"cast\", \"country\"]] = df[[\"director\", \"cast\", \"country\"]].fillna(\"Not Specified\")\ndf[\"rating\"] = df[\"rating\"].fillna(\"Not Rated\")\n\n# NR, UR and Not Rated all mean the same thing, so combine them\ndf[\"rating\"] = df[\"rating\"].replace({\"NR\": \"Not Rated\", \"UR\": \"Not Rated\"})\n\n# Convert date_added - the 10 missing dates are kept as blank (NaT)\n# so those titles still count everywhere except the date-based charts\ndf[\"date_added\"] = pd.to_datetime(df[\"date_added\"].str.strip(), format=\"%B %d, %Y\")\ndf[\"added_year\"] = df[\"date_added\"].dt.year.astype(\"Int64\")\ndf[\"added_month\"] = df[\"date_added\"].dt.month.astype(\"Int64\")\ndf[\"added_month_name\"] = df[\"date_added\"].dt.month_name()\n\n# Split duration into a number and a unit\ndf[\"duration_value\"] = df[\"duration\"].str.extract(r\"(\\d+)\", expand=False).astype(int)\ndf[\"duration_unit\"] = np.where(df[\"type\"] == \"Movie\", \"min\", \"Season(s)\")\n\n# Years between release and being added to Netflix\ndf[\"release_gap\"] = df[\"added_year\"] - df[\"release_year\"]\nprint(\"Negative release gaps:\", (df[\"release_gap\"] < 0).sum())\n\n# Check category columns only have expected values\nprint(df[\"type\